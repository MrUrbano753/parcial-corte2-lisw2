              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('Estado DRAFT', () => pm.expect(b.status).to.eql('DRAFT'));",
                  "pm.test('Header Location', () => pm.response.to.have.header('Location'));",
                  "pm.collectionVariables.set('questionId', b.questionId);"
                ]
              }
            }
          ]
