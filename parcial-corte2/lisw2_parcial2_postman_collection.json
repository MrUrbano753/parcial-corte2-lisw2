  "item": [
    {
      "name": "0. Validation Service (:8082)",
      "item": [
        {
          "name": "Validar justificación válida -> valid=true",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8082/validate",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8082",
              "path": [
                "validate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"¿Qué patrón GoF separa la construcción de un objeto complejo de su representación?\",\n  \"options\": [\n    {\n      \"id\": \"A\",\n      \"text\": \"Singleton\"\n    },\n    {\n      \"id\": \"B\",\n      \"text\": \"Builder\"\n    },\n    {\n      \"id\": \"C\",\n      \"text\": \"Adapter\"\n    },\n    {\n      \"id\": \"D\",\n      \"text\": \"Observer\"\n    }\n  ],\n  \"correctOptionId\": \"B\",\n  \"justification\": \"El patrón Builder construye el objeto paso a paso y valida antes de instanciarlo.\",\n  \"authorId\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('valid=true', () => pm.expect(pm.response.json().valid).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Validar justificación corta -> valid=false",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8082/validate",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8082",
              "path": [
                "validate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"¿Qué patrón GoF separa la construcción de un objeto complejo de su representación?\",\n  \"options\": [\n    {\n      \"id\": \"A\",\n      \"text\": \"Singleton\"\n    },\n    {\n      \"id\": \"B\",\n      \"text\": \"Builder\"\n    },\n    {\n      \"id\": \"C\",\n      \"text\": \"Adapter\"\n    },\n    {\n      \"id\": \"D\",\n      \"text\": \"Observer\"\n    }\n  ],\n  \"correctOptionId\": \"B\",\n  \"justification\": \"Muy corta\",\n  \"authorId\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('valid=false', () => pm.expect(pm.response.json().valid).to.eql(false));"
                ]
              }
            }
          ]
        }
      ]
