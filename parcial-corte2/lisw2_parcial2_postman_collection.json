    {
      "name": "2. Punto 2.2 - AMQP asíncrono con RabbitMQ",
      "item": [
        {
          "name": "Enviar a revisión -> 202 Accepted + operationId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8083/questions/{{questionId}}/submit",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8083",
              "path": [
                "questions",
                "{{questionId}}",
                "submit"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const b = pm.response.json();",
                  "pm.test('Trae operationId', () => pm.expect(b.operationId).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('operationId', b.operationId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Resultado de la operación -> COMPLETED",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8084/lifecycle/operations/{{operationId}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8084",
              "path": [
                "lifecycle",
                "operations",
                "{{operationId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 1500); // tiempo para que lifecycle-service consuma el mensaje"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('COMPLETED', () => pm.expect(pm.response.json().status).to.eql('COMPLETED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Estado de la pregunta -> PENDING_REVIEW",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8084/lifecycle/{{questionId}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8084",
              "path": [
                "lifecycle",
                "{{questionId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PENDING_REVIEW', () => pm.expect(pm.response.json().state).to.eql('PENDING_REVIEW'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reenviar la misma pregunta -> 202",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
